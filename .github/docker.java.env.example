### docker.env.java (TEMPLATE)
# Variáveis específicas para builds e runtimes Java.
#
# No GitHub Actions, configure em: Settings -> Secrets and variables -> Actions -> Variables

# === JAVA BUILDERS ===
DOCKER_JAVA_IMAGE_TO_BUILD_STANDARD=eclipse-temurin:21
DOCKER_JAVA_IMAGE_TO_BUILD_SPRING=ghcr.io/graalvm/graalvm-ce:ol8-java17
DOCKER_JAVA_IMAGE_TO_BUILD_QUARKUS=quay.io/quarkus/ubi-quarkus-mandrel-builder-image:23.1-java17

# === RUNTIME IMAGES ===
DOCKER_JAVA_IMAGE_TO_RUNTIME_JVM=gcr.io/distroless/java21-debian12
DOCKER_JAVA_IMAGE_TO_RUNTIME_NATIVE=gcr.io/distroless/cc-debian12

# === JAVA-SPECIFIC ===
DOCKER_JAVA_ARGS=
