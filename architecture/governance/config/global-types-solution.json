{
	"inventory": [
		{
			"path": "backend/java/spring/queue_workers",
			"stack": "backend",
			"platform": "java",
			"framework": "spring",
			"type": "queue_workers",
			"specification": {
				"platformVersion": "21",
				"platformDistributor": "temurin",
				"docker": {
					"dockerfile": "architecture/blueprints/backend/java/spring/queue_workers/v21/Dockerfile.native.21",
					"argCompilationMode": "native",
					"argImageBuild": "ghcr.io/graalvm/native-image-community:latest",
					"argImageRuntime": "gcr.io/distroless/cc-debian12",
					"argExposePort": 8080,
					"argCmdExtraBuilderPreCopy": "echo 'Framework: Preparando ambiente...'",
					"argCmdExtraBuilderPosCompile": "echo 'Framework: Compilação concluída.'",
					"argCmdExtraRuntimePreCopy": "echo 'Framework: Preparando runtime...'",
					"argCmdExtraRuntimePreCmd": "echo 'Framework: Finalizando imagem...'"
				},
				"compliance": {
					"sonarqubeThreshold": "80",
					"vulnerabilitySeverityLimit": "high",
					"maxCpu": "500m",
					"maxMemory": "1Gi",
					"licensePolicy": {
						"allowList": [
							"Apache-2.0",
							"MIT",
							"BSD-3-Clause",
							"EPL-2.0"
						],
						"denyList": [
							"GPL-3.0",
							"AGPL-3.0",
							"LGPL-3.0"
						],
						"actionOnUnknown": "warn"
					}
				}
			}
		}
	]
}